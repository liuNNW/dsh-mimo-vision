{
  "name": "dsh-mimo-vision",
  "version": "0.3.0",
  "description": "MiMo 视觉识别：对接小米 MiMo 模型，让 DeepSeek Harness 具备图片识别能力。发送带图消息时自动识别并把结果注入本次对话上下文；设置页可改模型、密钥引用与默认提示词。",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/liuNNW/dsh-mimo-vision.git"
  },
  "homepage": "https://github.com/liuNNW/dsh-mimo-vision#readme",
  "bugs": {
    "url": "https://github.com/liuNNW/dsh-mimo-vision/issues"
  },
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "locale",
    "cordis.patch.yml",
    "icon.svg",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    },
    "manifestVersion": 1
  },
  "icon": "./icon.svg",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "mimo",
    "vision",
    "image",
    "multimodal"
  ],
  "license": "MulanPSL-2.0",
  "engines": {
    "node": ">=20"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.5",
    "@deepseek-ai/dsh-credentials": "^0.2.0-rc.2",
    "@deepseek-ai/dsh-host-webserver": "^0.2.0-rc.2",
    "@deepseek-ai/dsh-llm": "^0.2.0-rc.2",
    "@deepseek-ai/dsh-tools": "^0.2.0-rc.2"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-credentials": {
      "optional": true
    },
    "@deepseek-ai/dsh-host-webserver": {
      "optional": true
    }
  }
}
